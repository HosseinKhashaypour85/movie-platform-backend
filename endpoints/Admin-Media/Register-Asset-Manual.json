{
  "name": "Register Asset Manually",
  "category": "Admin-Media",
  "method": "POST",
  "path": "/api/v1/admin/media/assets",
  "url": "http://localhost:8080/api/v1/admin/media/assets",
  "description": "ثبت دستی یک فایل رسانه‌ای آماده در سیستم (مثلاً پوستر در CDN یا لینک مستقیم)",
  "auth": {
    "required": true,
    "type": "bearer_admin",
    "description": "نیازمند توکن مدیر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_ADMIN_JWT_TOKEN>",
    "Content-Type": "application/json"
  },
  "url_params": {},
  "query_params": {},
  "request_body": {
    "kind": "poster",
    "mime_type": "image/webp",
    "movie_id": 1,
    "playback_url": "https://storage.example.com/movies/1/poster.webp",
    "size_bytes": 245000,
    "storage_key": "movies/1/poster.webp"
  },
  "request_fields": {
    "episode_id": {
      "type": "integer",
      "required": false,
      "description": "شناسه قسمت (اگر برای قسمت است)"
    },
    "kind": {
      "type": "string",
      "required": true,
      "description": "'video', 'trailer', 'poster'"
    },
    "mime_type": {
      "type": "string",
      "required": true,
      "description": "MIME type"
    },
    "movie_id": {
      "type": "integer",
      "required": false,
      "description": "شناسه فیلم (اگر برای فیلم است)"
    },
    "playback_url": {
      "type": "string",
      "required": false,
      "description": "URL مستقیم در صورت وجود"
    },
    "size_bytes": {
      "type": "integer",
      "required": true,
      "description": "حجم فایل به بایت"
    },
    "storage_key": {
      "type": "string",
      "required": true,
      "description": "کلید ذخیره‌سازی در باکت"
    }
  },
  "response_example": {
    "status": 201,
    "body": {
      "id": 2,
      "kind": "poster",
      "movie_id": 1,
      "playback_url": "https://storage.example.com/movies/1/poster.webp",
      "storage_key": "movies/1/poster.webp"
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/admin/media/assets\" \\\n  -H \"Authorization: Bearer <YOUR_ADMIN_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"movie_id\":1,\"kind\":\"poster\",\"storage_key\":\"movies/1/poster.webp\",\"mime_type\":\"image/webp\",\"size_bytes\":245000,\"playback_url\":\"https://storage.example.com/movies/1/poster.webp\"}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/admin/media/assets\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ movie_id: 1, kind: \"poster\", storage_key: \"movies/1/poster.webp\", mime_type: \"image/webp\", size_bytes: 245000, playback_url: \"https://storage.example.com/movies/1/poster.webp\" })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Admin-Media/Register-Asset-Manual.bru"
  }
}