{
  "name": "Complete And Verify S3 Upload",
  "category": "Admin-Media",
  "method": "POST",
  "path": "/api/v1/admin/media/uploads/complete",
  "url": "http://localhost:8080/api/v1/admin/media/uploads/complete",
  "description": "راستی‌آزمایی وجود فایل در باکت S3 و ثبت در دیتابیس و قرارگیری خودکار در صف ترنسکود HLS",
  "auth": {
    "required": true,
    "type": "bearer_admin",
    "description": "نیازمند توکن مدیر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_ADMIN_JWT_TOKEN>",
    "Content-Type": "application/json"
  },
  "url_params": {},
  "query_params": {},
  "request_body": {
    "kind": "video",
    "storage_key": "movies/1/video/source.mp4",
    "target_id": 1,
    "target_type": "movie"
  },
  "request_fields": {
    "kind": {
      "type": "string",
      "required": true,
      "description": "'video', 'trailer', 'poster'"
    },
    "storage_key": {
      "type": "string",
      "required": true,
      "description": "کلید آبجکت استوریج ذخیره‌شده"
    },
    "target_id": {
      "type": "integer",
      "required": true,
      "description": "شناسه هدف"
    },
    "target_type": {
      "type": "string",
      "required": true,
      "description": "'movie' یا 'episode'"
    }
  },
  "response_example": {
    "status": 201,
    "body": {
      "asset": {
        "id": 1,
        "is_active": false,
        "kind": "video",
        "mime_type": "video/mp4",
        "movie_id": 1,
        "size_bytes": 1048576000,
        "storage_key": "movies/1/video/source.mp4"
      },
      "message": "source upload verified; asset remains inactive until HLS processing completes",
      "status": "uploaded_pending_processing"
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/admin/media/uploads/complete\" \\\n  -H \"Authorization: Bearer <YOUR_ADMIN_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"target_type\":\"movie\",\"target_id\":1,\"kind\":\"video\",\"storage_key\":\"movies/1/video/source.mp4\"}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/admin/media/uploads/complete\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ target_type: \"movie\", target_id: 1, kind: \"video\", storage_key: \"movies/1/video/source.mp4\" })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Admin-Media/Complete-Media-Upload.bru"
  }
}