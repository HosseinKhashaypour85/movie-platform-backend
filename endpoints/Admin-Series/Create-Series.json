{
  "name": "Create Series",
  "category": "Admin-Series",
  "method": "POST",
  "path": "/api/v1/admin/series",
  "url": "http://localhost:8080/api/v1/admin/series",
  "description": "ایجاد یک سریال جدید در کاتالوگ",
  "auth": {
    "required": true,
    "type": "bearer_admin",
    "description": "نیازمند توکن مدیر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_ADMIN_JWT_TOKEN>",
    "Content-Type": "application/json"
  },
  "url_params": {},
  "query_params": {},
  "request_body": {
    "description": "When a young boy vanishes, a small town uncovers a mystery...",
    "is_published": true,
    "release_year": 2016,
    "slug": "stranger-things",
    "title": "Stranger Things"
  },
  "request_fields": {
    "description": {
      "type": "string",
      "required": false,
      "description": "توضیحات سریال"
    },
    "is_published": {
      "type": "boolean",
      "required": true,
      "description": "وضعیت انتشار"
    },
    "release_year": {
      "type": "integer",
      "required": true,
      "description": "سال آغاز انتشار"
    },
    "slug": {
      "type": "string",
      "required": true,
      "description": "اسلاگ یکتا"
    },
    "title": {
      "type": "string",
      "required": true,
      "description": "عنوان سریال"
    }
  },
  "response_example": {
    "status": 201,
    "body": {
      "id": 2,
      "is_published": true,
      "release_year": 2016,
      "slug": "stranger-things",
      "title": "Stranger Things"
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/admin/series\" \\\n  -H \"Authorization: Bearer <YOUR_ADMIN_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"title\":\"Stranger Things\",\"slug\":\"stranger-things\",\"release_year\":2016,\"is_published\":true}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/admin/series\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ title: \"Stranger Things\", slug: \"stranger-things\", release_year: 2016, is_published: true })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Admin-Series/Create-Series.bru"
  }
}