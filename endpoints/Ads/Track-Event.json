{
  "name": "Track Ad Event",
  "category": "Ads",
  "method": "POST",
  "path": "/api/v1/ads/{id}/events",
  "url": "http://localhost:8080/api/v1/ads/1/events",
  "description": "ثبت رویداد نمایش (impression) یا کلیک (click) برای یک تبلیغ",
  "auth": {
    "required": false,
    "type": "none",
    "description": "اندپوینت عمومی"
  },
  "headers": {
    "Content-Type": "application/json"
  },
  "url_params": {
    "id": {
      "type": "integer",
      "required": true,
      "example": 1,
      "description": "شناسه کمپین تبلیغاتی"
    }
  },
  "query_params": {},
  "request_body": {
    "event_type": "impression",
    "metadata": "{\"device\":\"mobile\"}"
  },
  "request_fields": {
    "event_type": {
      "type": "string",
      "required": true,
      "description": "نوع رویداد: 'impression' یا 'click'"
    },
    "metadata": {
      "type": "string",
      "required": false,
      "description": "متادیتا یا اطلاعات دستگاه به صورت رشته/JSON"
    }
  },
  "response_example": {
    "status": 201,
    "body": {
      "message": "event tracked successfully"
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/ads/1/events\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"event_type\":\"impression\",\"metadata\":\"{\\\"device\\\":\\\"mobile\\\"}\"}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/ads/1/events\", {\n  method: \"POST\",\n  headers: { \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ event_type: \"impression\", metadata: \"{\\\"device\\\":\\\"mobile\\\"}\" })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Ads/Track-Event.bru"
  }
}