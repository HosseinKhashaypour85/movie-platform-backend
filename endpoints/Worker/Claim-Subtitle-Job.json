  "method": "POST",
  "path": "/internal/v1/worker/subtitle-jobs/claim",
  "url": "http://localhost:8080/internal/v1/worker/subtitle-jobs/claim",
  "description": "تحویل گرفتن و قفل کردن جاب بعدی تولید زیرنویس از صف پردازش توسط ورکر",
  "auth": {
