    "body": {
      "job": {
        "id": 1,
        "source_asset_id": 1,
        "source_language": "en",
        "status": "processing",
        "target_language": "fa"
      },
      "source_video_url": "https://s3.example.com/download/source.mp4?..."
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/internal/v1/worker/subtitle-jobs/claim\" \\\n  -H \"Authorization: Bearer <YOUR_WORKER_TOKEN>\"",
    "javascript_fetch": "fetch(\"http://localhost:8080/internal/v1/worker/subtitle-jobs/claim\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + workerToken }\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Worker/Claim-Subtitle-Job.bru"
