{
  "name": "Change Password",
  "category": "Users",
  "method": "POST",
  "path": "/api/v1/profile/change-password",
  "url": "http://localhost:8080/api/v1/profile/change-password",
  "description": "تغییر کلمه عبور کاربر و ابطال همزمان تمامی نشست‌های دیگر در سایر دستگاه‌ها",
  "auth": {
    "required": true,
    "type": "bearer_user",
    "description": "نیازمند JWT Bearer Token کاربر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_JWT_TOKEN>",
    "Content-Type": "application/json"
  },
  "url_params": {},
  "query_params": {},
  "request_body": {
    "current_password": "SuperSecurePass123!",
    "new_password": "NewStrongPassword2026!"
  },
  "request_fields": {
    "current_password": {
      "type": "string",
      "required": true,
      "description": "رمز عبور فعلی کاربر"
    },
    "new_password": {
      "type": "string",
      "required": true,
      "description": "رمز عبور جدید (حداقل ۸ کاراکتر)"
    }
  },
  "response_example": {
    "status": 200,
    "body": {
      "message": "password updated successfully; other sessions revoked"
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/profile/change-password\" \\\n  -H \"Authorization: Bearer <YOUR_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"current_password\":\"SuperSecurePass123!\",\"new_password\":\"NewStrongPassword2026!\"}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/profile/change-password\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ current_password: \"SuperSecurePass123!\", new_password: \"NewStrongPassword2026!\" })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Users/Change-Password.bru"
  }
}