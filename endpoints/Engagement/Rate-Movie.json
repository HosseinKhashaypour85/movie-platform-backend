{
  "name": "Rate Movie",
  "category": "Engagement",
  "method": "POST",
  "path": "/api/v1/movies/{movieID}/ratings",
  "url": "http://localhost:8080/api/v1/movies/1/ratings",
  "description": "ثبت یا تغییر امتیاز کاربر (بین ۱ تا ۱۰) برای یک فیلم",
  "auth": {
    "required": true,
    "type": "bearer_user",
    "description": "نیازمند توکن کاربر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_JWT_TOKEN>",
    "Content-Type": "application/json"
  },
  "url_params": {
    "movieID": {
      "type": "integer",
      "required": true,
      "example": 1,
      "description": "شناسه فیلم"
    }
  },
  "query_params": {},
  "request_body": {
    "score": 9
  },
  "request_fields": {
    "score": {
      "type": "integer",
      "required": true,
      "description": "نمره امتیاز بین ۱ تا ۱۰"
    }
  },
  "response_example": {
    "status": 200,
    "body": {
      "message": "rating saved successfully",
      "movie_id": 1,
      "score": 9
    }
  },
  "how_to_run": {
    "curl": "curl -X POST \"http://localhost:8080/api/v1/movies/1/ratings\" \\\n  -H \"Authorization: Bearer <YOUR_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"score\":9}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/movies/1/ratings\", {\n  method: \"POST\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ score: 9 })\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Engagement/Rate-Movie.bru"
  }
}