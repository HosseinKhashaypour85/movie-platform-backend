  "how_to_run": {
    "curl": "curl -X PUT \"http://localhost:8080/api/v1/admin/movies/2\" \\\n  -H \"Authorization: Bearer <YOUR_ADMIN_JWT_TOKEN>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"title\":\"Interstellar (IMAX)\",\"slug\":\"interstellar-imax\",\"release_year\":2014,\"duration_minutes\":169,\"genre_id\":1,\"is_published\":true}'",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/admin/movies/2\", {\n  method: \"PUT\",\n  headers: { \"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ title: \"Interstellar (IMAX)\", slug: \"interstellar-imax\", release_year: 2014, duration_minutes: 169, genre_id: 1, is_published: true })\n}).then(r => r.json()).then(console.log);",
