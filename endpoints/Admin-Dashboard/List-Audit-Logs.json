{
  "name": "List Admin Audit Logs",
  "category": "Admin-Dashboard",
  "method": "GET",
  "path": "/api/v1/admin/audit-logs",
  "url": "http://localhost:8080/api/v1/admin/audit-logs?limit=50&offset=0",
  "description": "مشاهده لاگ‌های امنیتی تغییرات اعمال شده توسط ادمین‌ها (Audit Trail)",
  "auth": {
    "required": true,
    "type": "bearer_admin",
    "description": "نیازمند توکن مدیر"
  },
  "headers": {
    "Authorization": "Bearer <YOUR_ADMIN_JWT_TOKEN>"
  },
  "url_params": {},
  "query_params": {
    "action": {
      "type": "string",
      "required": false,
      "description": "فیلتر بر اساس نام عملیات"
    },
    "limit": {
      "type": "integer",
      "required": false,
      "default": 50,
      "description": "تعداد لاگ در صفحه"
    },
    "offset": {
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "آفست"
    },
    "user_id": {
      "type": "integer",
      "required": false,
      "description": "فیلتر بر اساس شناسه مدیر"
    }
  },
  "request_body": null,
  "request_fields": {},
  "response_example": {
    "status": 200,
    "body": {
      "items": [
        {
          "action": "CREATE_MOVIE",
          "created_at": "2026-11-20T12:00:00Z",
          "entity_id": 1,
          "entity_type": "movie",
          "id": 1,
          "ip_address": "127.0.0.1",
          "user_id": 1
        }
      ],
      "total": 1
    }
  },
  "how_to_run": {
    "curl": "curl -X GET \"http://localhost:8080/api/v1/admin/audit-logs?limit=50&offset=0\" \\\n  -H \"Authorization: Bearer <YOUR_ADMIN_JWT_TOKEN>\"",
    "javascript_fetch": "fetch(\"http://localhost:8080/api/v1/admin/audit-logs?limit=50&offset=0\", {\n  headers: { \"Authorization\": \"Bearer \" + token }\n}).then(r => r.json()).then(console.log);",
    "bruno": "bruno/Admin-Dashboard/List-Audit-Logs.bru"
  }
}