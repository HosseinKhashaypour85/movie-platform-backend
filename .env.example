APP_ENV=development
APP_PORT=8080
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=movie_app
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=movie_platform
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=movie-platform
JWT_TTL=15m

# Generate a dedicated high-entropy token for the subtitle worker
SUBTITLE_WORKER_TOKEN=replace-with-a-long-random-worker-token

# Optional signed HLS manifest issuance (both values required together)
# The CDN MUST verify signatures for the manifest AND every media segment.
PLAYBACK_CDN_BASE_URL=https://cdn.example.com
# Generate a separate high-entropy secret; do not reuse JWT_SECRET.
PLAYBACK_SIGNING_KEY=replace-with-a-dedicated-random-secret-at-least-32-bytes
