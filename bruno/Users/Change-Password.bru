meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/profile/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "current_password": "SuperSecurePass123!",
  "new_password": "NewSuperPassword2026!"
}
}
