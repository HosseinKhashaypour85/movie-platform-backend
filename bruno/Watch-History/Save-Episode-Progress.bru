meta {
  name: Save Episode Progress
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/watch-history/episodes/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "progress_seconds": 600,
  "duration_seconds": 2400
}
}
