meta {
  name: Create Movie
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/movies
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "title": "Inception",
  "original_title": "Inception",
  "slug": "inception-2010",
  "synopsis": "A thief who enters the dreams of others...",
  "release_year": 2010,
  "duration_minutes": 148,
  "age_rating": "PG-13",
  "poster_url": "https://example.com/posters/inception.jpg",
  "backdrop_url": "https://example.com/backdrops/inception.jpg",
  "language": "English",
  "country": "United States",
  "imdb_rating": 8.8,
  "is_published": true
}
}
