meta {
  name: Create Episode
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/episodes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
{
  "season_id": 1,
  "number": 1,
  "title": "Pilot",
  "synopsis": "Walter White learns of his diagnosis...",
  "duration_minutes": 58,
  "thumbnail_url": "https://example.com/episodes/pilot.jpg",
  "is_published": true
}
}
